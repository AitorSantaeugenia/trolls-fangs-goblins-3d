# Copia este archivo como .env (en esta misma carpeta) para que «node server.mjs» lo lea al arrancar.
# El .env no se sube nunca a Git: puede llevar la contraseña de la base de datos.
# Sin MONGODB_URI, el servidor guarda todo en data/scores.json.

# MongoDB en tu ordenador (MongoDB Compass / Community Server)
MONGODB_URI=mongodb://localhost:27017
# o MongoDB Atlas:
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/
MONGODB_DB=tfg3d

# Opcionales
# PORT=8080
# DATA_DIR=./data
